{
  "name": "audit-ci",
  "version": "7.1.0",
  "description": "Audits NPM, Yarn, and PNPM projects in CI environments",
  "keywords": [
    "actions",
    "audit",
    "ci",
    "circleci",
    "github",
    "github-actions",
    "npm",
    "pnpm",
    "security",
    "yarn"
  ],
  "homepage": "https://github.com/IBM/audit-ci",
  "bugs": "https://github.com/IBM/audit-ci/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:IBM/audit-ci.git"
  },
  "bin": "./dist/bin.js",
  "files": [
    "dist/*",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "tsgo": "tsgo -p tsconfig.build.json",
    "build": "rm -rf dist && tsgo -p tsconfig.build.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "check-types": "tsgo -p tsconfig.json",
    "schema": "ts-json-schema-generator -p ./docs/schema.d.ts -o ./docs/schema.json -t Schema"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "escape-string-regexp": "^5.0.0",
    "event-stream": "4.0.1",
    "jju": "^1.4.0",
    "jsonstream-next": "^3.0.0",
    "readline-transform": "2.0.0",
    "semver": "^7.8.0",
    "tslib": "^2.8.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/event-stream": "^4.0.6",
    "@types/jju": "^1.4.5",
    "@types/jsonstream-next": "^3.0.3",
    "@types/node": "^24.12.4",
    "@types/readline-transform": "^1.0.5",
    "@types/semver": "^7.7.1",
    "@types/yargs": "^17.0.35",
    "@typescript/native-preview": "7.0.0-dev.20260513.1",
    "@vitest/coverage-v8": "^4.1.6",
    "audit-types": "^0.6.2",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "0.22.1",
    "ts-json-schema-generator": "^2.9.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
